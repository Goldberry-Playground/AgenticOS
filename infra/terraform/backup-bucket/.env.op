# 1Password env-file template — `op run --env-file=.env.op -- terraform apply`
# resolves the op:// references to real values and injects them as env vars, so
# no secret ever reaches shell scrollback, history, or this repo.
#
# Committed on purpose: it holds references, not secrets.
#
# The Terraform S3 backend (agenticos-tfstate) needs its own credentials, which
# are the bucket-scoped tfstate key, NOT the account-wide plumbing key below.
# spaces_bootstrap_secret_key's 1Password field label has a trailing space, so
# it is referenced by field id (f6upwbtfs7jo7f4avwe6kivcwu), not by label.

TF_VAR_do_token=op://Goldberry Grove - Admin/AgenticOS Infra/do_token
TF_VAR_spaces_bootstrap_access_key_id=op://Goldberry Grove - Admin/Grove Infra/spaces_bootstrap_access_key_id
TF_VAR_spaces_bootstrap_secret_key=op://Goldberry Grove - Admin/Grove Infra/f6upwbtfs7jo7f4avwe6kivcwu

# Backend auth (bucket-scoped to agenticos-tfstate).
AWS_ACCESS_KEY_ID=op://Goldberry Grove - Admin/AgenticOS Infra/tfstate_spaces_access_key_id
AWS_SECRET_ACCESS_KEY=op://Goldberry Grove - Admin/AgenticOS Infra/tfstate_spaces_secret_key
